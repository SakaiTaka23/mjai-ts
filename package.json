{
  "name": "mjai-ts",
  "version": "0.1.9",
  "description": "TypeScript library for parsing and managing mjai format mahjong game logs with core game state management",
  "license": "MIT",
  "keywords": [
    "mahjong",
    "riichi",
    "game"
  ],
  "author": "Takafumi Sakai",
  "homepage": "https://github.com/SakaiTaka23/mjai-ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SakaiTaka23/mjai-ts.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.6.4",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.8.1",
    "tsdown": "^0.21.7",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.2"
  }
}
