{
  "compilerOptions": {
    "target": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "paths": {
      "@types": ["src/types"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["*.js", "*.ts", "dist"]
}
